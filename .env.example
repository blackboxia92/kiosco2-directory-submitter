TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token
TELEGRAM_CHANNEL_ID=1577307373
TWOCAPTCHA_API_KEY=replace_with_your_2captcha_key

# Seguridad del webhook. Si tiene valor, enviar X-API-Key en cada request.
WEBHOOK_SECRET=replace_with_a_long_random_value

# Seguro por defecto: rellena y captura, pero no pulsa Submit.
DRY_RUN=true
HEADLESS=true

# Persistencia y artefactos. En Railway, montar un volumen en /app/data.
DATABASE_PATH=data/jobs.sqlite3
ARTIFACT_DIR=data/artifacts

# Kill rules y timeouts.
CAPTCHA_TIMEOUT_SECONDS=60
NAVIGATION_TIMEOUT_MS=30000
POST_SUBMIT_WAIT_SECONDS=8
DIRECTORY_MAX_ATTEMPTS=2
